# Copie para .env e preencha. Nunca versione o arquivo .env.

# Obrigatório
OPENAI_API_KEY=sk-...

# Modelos
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4.1-mini
LLM_TEMPERATURE=0.0

# RAG
# Similaridade de cosseno mínima para acionar a LLM. Abaixo disso -> Fallback Seguro.
SIMILARITY_THRESHOLD=0.75
TOP_K=3
KNOWLEDGE_BASE_PATH=base_conhecimento_ifood_genai-exemplo.csv
# Cache local dos embeddings da base (deixe vazio para desativar)
EMBEDDINGS_CACHE_DIR=.cache

# Guardrails / resiliência
MAX_INPUT_CHARS=1000
REQUEST_TIMEOUT_S=30
MAX_RETRIES=2

LOG_LEVEL=INFO

# Link de suporte incluído em toda resposta de baixa confiança (Fluxo Suporte)
SUPPORT_URL=https://suporte-interno.exemplo/reembolsos
